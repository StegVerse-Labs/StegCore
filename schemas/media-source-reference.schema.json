{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/media-source-reference.schema.json",
  "title": "Governed Media Source Reference",
  "type": "object",
  "required": ["source_id", "source_kind", "uri", "custody", "integrity", "window", "provenance"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["VIDEO", "AUDIO", "IMAGE_SEQUENCE", "MIXED"]},
    "uri": {"type": ["string", "null"]},
    "custody": {"enum": ["REFERENCED", "LOCAL", "LICENSED", "USER_SUPPLIED", "UNKNOWN"]},
    "integrity": {
      "type": "object",
      "required": ["verification_state"],
      "properties": {
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "verification_state": {"enum": ["VERIFIED", "UNVERIFIED", "PARTIAL", "UNKNOWN"]}
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "frame_anchors": {"type": "array"}
      },
      "additionalProperties": false
    },
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
