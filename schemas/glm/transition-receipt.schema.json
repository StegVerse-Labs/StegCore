{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/well-known/glm/schemas/transition-receipt.schema.json",
  "title": "StegVerse Transition Receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "transition_id",
    "layer_id",
    "issued_at_utc",
    "admissibility_result",
    "authority_class",
    "policy_reference",
    "review_posture",
    "commit_time_validity",
    "visible_context",
    "external_assumptions",
    "non_claims"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "layer_id": {"type": "string", "const": "stegverse-transition-admissibility"},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "admissibility_result": {"type": "string", "enum": ["ADMIT", "DENY", "NEEDS_REVIEW"]},
    "authority_class": {"$ref": "authority-class.schema.json"},
    "policy_reference": {"$ref": "policy-reference.schema.json"},
    "review_posture": {"type": "string", "enum": ["automated", "human_reviewed", "council_reviewed", "external_review_required"]},
    "commit_time_validity": {
      "type": "object",
      "required": ["valid_at_commit", "commit_time_utc"],
      "properties": {
        "valid_at_commit": {"type": "boolean"},
        "commit_time_utc": {"type": "string", "format": "date-time"},
        "failure_reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "visible_context": {
      "type": "object",
      "description": "Context visible to the StegVerse layer at commit time.",
      "additionalProperties": true
    },
    "external_assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "non_claims": {
      "type": "array",
      "items": {"type": "string"}
    },
    "replay_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "available"],
        "properties": {
          "name": {"type": "string"},
          "available": {"type": "boolean"},
          "reference": {"type": "string"},
          "sha256": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
