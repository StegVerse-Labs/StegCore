{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/temporal-event.schema.json",
  "title": "Temporal Event",
  "type": "object",
  "required": ["event_id", "source", "window", "observations", "representation", "uncertainty", "provenance"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_time": {"type": ["string", "null"], "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["source_id", "source_kind", "custody", "integrity"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["VIDEO", "AUDIO", "IMAGE_SEQUENCE", "DOCUMENT", "SENSOR", "MIXED"]},
        "uri": {"type": ["string", "null"]},
        "custody": {"enum": ["REFERENCED", "LOCAL", "LICENSED", "USER_SUPPLIED", "UNKNOWN"]},
        "integrity": {
          "type": "object",
          "required": ["verification_state"],
          "properties": {
            "sha256": {"type": ["string", "null"]},
            "verification_state": {"enum": ["VERIFIED", "UNVERIFIED", "PARTIAL", "UNKNOWN"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0},
        "frame_anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "offset_ms"],
            "properties": {
              "label": {"type": "string"},
              "offset_ms": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observation_id", "subject", "predicate", "object", "state"],
        "properties": {
          "observation_id": {"type": "string"},
          "subject": {"type": "string"},
          "predicate": {"type": "string"},
          "object": {},
          "state": {"enum": ["OBSERVED", "INFERRED", "UNRESOLVED", "CONTRADICTORY"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "representation": {
      "type": "object",
      "required": ["assertion", "encoding_version"],
      "properties": {
        "assertion": {"const": "INTERPRETIVE_ENCODING_NOT_GROUND_TRUTH"},
        "encoding_version": {"type": "string"},
        "alternative_representation_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": ["source_uncertainty", "observation_uncertainty", "semantic_mapping_uncertainty"],
      "properties": {
        "source_uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "observation_uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "semantic_mapping_uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"window": {"required": ["start_ms", "end_ms"]}}},
      "then": {"properties": {"window": {"properties": {"end_ms": {"minimum": 1}}}}}
    }
  ],
  "additionalProperties": false
}
