{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/StegCore/contracts/release_policy/independent-release-policy.v1.json",
  "title": "StegCore Imported Independent Release Policy Evidence v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_type",
    "schema_version",
    "status",
    "decision",
    "policy_id",
    "decision_owner",
    "source_repository",
    "source_commit",
    "source_path",
    "decision_hash",
    "candidate_version",
    "candidate_tag",
    "candidate_commit",
    "next_permitted_action",
    "release_created",
    "tag_created",
    "deployment_authorized",
    "continuity_receipt_minted"
  ],
  "properties": {
    "artifact_type": {"const": "stegcore.independent_release_policy_evidence"},
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["pass", "deny", "fail_closed"]},
    "decision": {"enum": ["ALLOW", "DENY", "FAIL_CLOSED"]},
    "policy_id": {"type": "string", "minLength": 1},
    "decision_owner": {"const": "StegVerse-Labs/Governance"},
    "source_repository": {"const": "StegVerse-Labs/Governance"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_path": {"type": "string", "minLength": 1},
    "decision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "candidate_tag": {"type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "next_permitted_action": {"const": "create annotated tag only"},
    "release_created": {"const": false},
    "tag_created": {"const": false},
    "deployment_authorized": {"const": false},
    "continuity_receipt_minted": {"const": false}
  }
}
