{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/StegCore/contracts/release_policy/independent-release-policy.v1.json",
  "title": "StegCore Independent Release Policy Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "policy_version",
    "authority_ref",
    "repository",
    "candidate_commit",
    "release_readiness_assessment_hash",
    "runtime_evidence_hash",
    "governance_freshness_evidence_hash",
    "verdict",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "stegcore.independent-release-policy.v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "authority_ref": {"type": "string", "minLength": 1},
    "repository": {"const": "StegVerse-Labs/StegCore"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_readiness_assessment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "governance_freshness_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["PASS", "DENY"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string"},
    "proof_ref": {"type": ["string", "null"]}
  }
}
