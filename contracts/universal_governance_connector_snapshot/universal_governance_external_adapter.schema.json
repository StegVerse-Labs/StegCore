{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/universal_governance_external_adapter.v1.json",
  "title": "StegVerse Universal Governance External-System Adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "system_id",
    "boundary_id",
    "governance_profile_id",
    "enforcement_claim",
    "bypass_path_declared",
    "operations",
    "authority_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "stegverse.governance-external-adapter.v1"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "boundary_id": {
      "type": "string",
      "minLength": 1
    },
    "governance_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "enforcement_claim": {
      "enum": [
        "OBSERVABLE",
        "GOVERNED",
        "ENFORCED"
      ]
    },
    "bypass_path_declared": {
      "type": "boolean"
    },
    "bypass_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "native_operation",
          "governance_operation_id",
          "protected_consequence",
          "consequence_authority_ref_required",
          "input_mapping",
          "evidence_mapping"
        ],
        "properties": {
          "native_operation": {
            "type": "string",
            "minLength": 1
          },
          "governance_operation_id": {
            "type": "string",
            "minLength": 1
          },
          "protected_consequence": {
            "type": "boolean"
          },
          "consequence_authority_ref_required": {
            "const": true
          },
          "input_mapping": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_mapping": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_grants_execution_authority",
        "adapter_grants_credential_authority",
        "governance_allow_executes_consequence",
        "credential_authority",
        "authority_effect"
      ],
      "properties": {
        "adapter_grants_execution_authority": {
          "const": false
        },
        "adapter_grants_credential_authority": {
          "const": false
        },
        "governance_allow_executes_consequence": {
          "const": false
        },
        "credential_authority": {
          "const": "TV/TVC"
        },
        "authority_effect": {
          "const": "NONE"
        }
      }
    }
  }
}
