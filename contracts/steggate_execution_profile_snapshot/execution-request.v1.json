{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/ara-admissibility-interop/schemas/execution-request.v1.json",
  "title": "StegGate Deterministic Execution Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","execution_id","candidate_id","candidate_hash","credential_binding","action","capability_surface","authority_ref","profile_ref"],
  "properties": {
    "schema_version": {"const":"steggate.execution-request.v1"},
    "execution_id": {"type":"string","minLength":1},
    "candidate_id": {"type":"string","minLength":1},
    "candidate_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "credential_binding": {
      "type":"object",
      "additionalProperties":false,
      "required":["credential_id","credential_hash","subject_binding"],
      "properties": {
        "credential_id":{"type":"string","minLength":1},
        "credential_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "subject_binding":{"type":"string","minLength":1}
      }
    },
    "action": {
      "type":"object",
      "additionalProperties":false,
      "required":["name","parameters"],
      "properties": {
        "name":{"type":"string","minLength":1},
        "parameters":{"type":"object"}
      }
    },
    "capability_surface": {
      "type":"object",
      "additionalProperties":false,
      "required":["actions_exposed","execution_mode","requires_governed_commit"],
      "properties": {
        "actions_exposed":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "execution_mode":{"enum":["manual","bounded","governed"]},
        "requires_governed_commit":{"const":true},
        "parameter_bounds":{"type":"object"},
        "confirmation_required":{"type":"boolean"}
      }
    },
    "upstream_capability_surface":{"type":"object"},
    "authority_ref":{"type":"string","minLength":1},
    "profile_ref":{"const":"SG-EXECUTION-DETERMINISTIC-v1"}
  }
}
