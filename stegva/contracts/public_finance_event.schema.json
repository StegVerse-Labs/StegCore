{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/stegva/public-finance-event-v1.json",
  "title": "StegVA Public Finance Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "posting_date", "effective_date", "direction", "amount", "currency", "category", "counterparty_class", "approval_receipts", "source_commitment", "reconciliation_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^STEGVA-FIN-[A-Z0-9-]{8,64}$"},
    "posting_date": {"type": "string", "format": "date"},
    "effective_date": {"type": "string", "format": "date"},
    "direction": {"enum": ["INFLOW", "OUTFLOW"]},
    "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{2})$"},
    "currency": {"const": "USD"},
    "category": {"type": "string", "minLength": 1},
    "restricted_purpose": {"type": ["string", "null"]},
    "counterparty_class": {"type": "string", "minLength": 1},
    "approval_receipts": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "source_commitment": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reconciliation_status": {"enum": ["UNRECONCILED", "RECONCILED", "CORRECTED", "VOID"]},
    "supersedes": {"type": "string"},
    "public_filing_reference": {"type": "string"}
  }
}
