{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/spec/v1.3/decision_receipt.schema.json",
  "title": "StegVerse Decision Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["transition_id", "decision", "reason_codes", "policy_reference", "policy_version", "state_digest", "evaluator_version", "evaluated_at", "receipt_digest"],
  "properties": {
    "transition_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["ALLOW", "DENY", "FAIL_CLOSED"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "policy_reference": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "delegation_reference": {"type": ["string", "null"]},
    "evidence_references": {"type": "array", "items": {"type": "string"}},
    "state_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "evaluator_version": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "receipt_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
  }
}
