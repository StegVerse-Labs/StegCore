{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/admissibility_stage_vector.schema.json",
  "title": "StegVerse Governance Admissibility Stage Vector",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "governance_classes", "stages", "aggregate_disposition", "authority_boundaries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "transition_id": {"type": "string", "minLength": 1},
    "governance_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"]}
    },
    "stages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"$ref": "#/$defs/a0"}, {"$ref": "#/$defs/a1"}, {"$ref": "#/$defs/a2"},
        {"$ref": "#/$defs/a3"}, {"$ref": "#/$defs/a4"}, {"$ref": "#/$defs/a5"},
        {"$ref": "#/$defs/a6"}, {"$ref": "#/$defs/a7"}, {"$ref": "#/$defs/a8"}
      ],
      "items": false
    },
    "aggregate_disposition": {"enum": ["ALLOW", "DENY", "FAIL_CLOSED", "QUARANTINE", "REPLACEMENT", "FORK", "UNKNOWN"]},
    "failure_stage": {"type": ["string", "null"], "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", null]},
    "region_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "disposition"],
        "properties": {
          "region_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["ALLOW", "DENY", "FAIL_CLOSED", "QUARANTINE", "REPLACEMENT", "FORK", "UNKNOWN"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomy_grants_execution_authority", "continuity_receipt_minted", "certification_granted", "custody_granted"],
      "properties": {
        "taxonomy_grants_execution_authority": {"const": false},
        "continuity_receipt_minted": {"const": false},
        "certification_granted": {"const": false},
        "custody_granted": {"const": false}
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "name", "status", "evidence_refs"],
      "properties": {
        "stage": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "INDETERMINATE"]},
        "reason_code": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "a0": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "A0"}}}]},
    "a1": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "A1"}}}]},
    "a2": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "A2"}}}]},
    "a3": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "A3"}}}]},
    "a4": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "A4"}}}]},
    "a5": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "A5"}}}]},
    "a6": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "A6"}}}]},
    "a7": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "A7"}}}]},
    "a8": {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage": {"const": "A8"}}}]}
  }
}
