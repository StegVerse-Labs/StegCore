{
  "schema": "stegverse.sdk.portable-package-catalog.v1",
  "channel": "SDK_EARLY_ACCESS",
  "purpose": "Developer/community distribution of portable StegVerse ecosystem packages before later app or paid-product promotion.",
  "distribution_posture": {
    "console_download_supported": true,
    "console_install_supported": true,
    "public_app_store_product": false,
    "paid_product": false,
    "duration_policy": "governed_channel_lifecycle_not_hardcoded",
    "requires_provider_account": false,
    "requires_non_tv_tvc_secret": false,
    "required_archive_formats": ["zip", "tar.gz"],
    "same_payload_across_formats_required": true,
    "independent_archive_hashes_required": true
  },
  "packages": {
    "S": {
      "package_id": "stegverse-sdk-s-micro-ecosystem",
      "package_generation": "0",
      "package_version_component": "S_package",
      "display_name": "StegVerse S Micro-Ecosystem",
      "deployment_class": "S",
      "description": "Portable isolated Sovereign StegGate/AdmittedCode ecosystem unit.",
      "node_membership_claim": false
    },
    "NS": {
      "package_id": "stegverse-sdk-ns-micro-ecosystem",
      "package_generation": "0",
      "package_version_component": "NS_package",
      "display_name": "StegVerse NS Micro-Ecosystem",
      "deployment_class": "NS",
      "description": "Portable Node Sovereign profile package. Installation does not self-accredit Node Sovereign membership.",
      "node_membership_claim": false,
      "node_membership_activation_required": true
    }
  },
  "required_payload_paths": [
    "micro_ecosystem/manifest.json",
    "micro_ecosystem/node_sovereign_profile.v1.json",
    "docs/STEGVERSE_NODE_SOVEREIGN_DEFINITION.md",
    "examples/steggate_allow_request.json",
    "src/stegcore",
    "pyproject.toml"
  ],
  "package_invariants": [
    "explicit_S_or_NS_selection",
    "canonical_runtime_identity_preserved",
    "no_embedded_secrets",
    "no_provider_account_requirement",
    "NS_installation_does_not_create_membership",
    "package_manifest_hashes_every_file",
    "package_receipt_records_source_commit_when_available",
    "zip_and_tar_gz_built_from_same_payload",
    "zip_and_tar_gz_have_independent_sha256",
    "package_family_identity_is_stable",
    "package_version_is_explicit",
    "archive_filename_contains_package_version"
  ],
  "future_product_profiles": {
    "StegOS": {
      "inherits_S_NS_deployment_classes": true,
      "additional_hardware_or_image_profile_allowed": true,
      "required_archive_formats": ["zip", "tar.gz"],
      "additional_bootable_image_artifacts_allowed": true,
      "github_reproducible_build_allowed": true,
      "github_runtime_authority": false,
      "node_membership_self_accreditation_allowed": false,
      "profile_ref": "docs/STEGOS_SDK_DISTRIBUTION_PROFILE.md"
    }
  },
  "future_promotion_states": [
    "SDK_EARLY_ACCESS",
    "SDK_COMMUNITY",
    "APP_PRODUCT_CANDIDATE",
    "PAID_PRODUCT_CANDIDATE"
  ]
}
